{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "GDG Community Studio",
        "supportEmail": "alexander.plachykov@gmail.com"
      }
    }
  },
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/list-apps",
        "run": {
          "serviceId": "community-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/run",
        "run": {
          "serviceId": "community-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/run_sse",
        "run": {
          "serviceId": "community-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/apps/**",
        "run": {
          "serviceId": "community-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
