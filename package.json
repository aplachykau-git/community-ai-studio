{
  "name": "community-studio-workspace",
  "private": true,
  "scripts": {
    "start": "./start_a2a_workspace.sh",
    "dev": "npm run dev --prefix frontend",
    "dev:a2a": "./start_a2a_workspace.sh",
    "build": "npm run build --prefix frontend",
    "agents:start": "uv run --locked adk web --port 8080 agents",
    "a2a:video": "uv run --locked uvicorn agents.video_editor.a2a_server:a2a_app --host 0.0.0.0 --port 8081",
    "a2a:receipt": "uv run --locked uvicorn agents.receipt_scanner.a2a_server:a2a_app --host 0.0.0.0 --port 8082",
    "a2a:root": "VIDEO_AGENT_A2A_URL=http://localhost:8081 RECEIPT_AGENT_A2A_URL=http://localhost:8082 uv run --locked adk web --port 8080 agents",
    "video:dev": "npm run dev --prefix agents/video_editor",
    "video:render": "npm run render --prefix agents/video_editor",
    "video:check": "npm run check --prefix agents/video_editor",
    "test": "PYTHONWARNINGS='ignore::DeprecationWarning' .venv/bin/python3 -m unittest discover tests/ -v",
    "deploy:cloudrun": "./deploy/deploy_a2a_cloudrun.sh",
    "deploy:frontend": "npm run build --prefix frontend && npx -y firebase-tools deploy --only hosting"
  }
}
